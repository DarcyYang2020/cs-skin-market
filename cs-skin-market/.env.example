# ============================================================
# CS-Market 环境变量样例（AUTH-1，2026-08-21）
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，切勿提交真实凭据。
# 参考: pipeline/config.py 的 _load_dotenv（轻量解析，仅填充未设置的环境变量）
# ============================================================

# ---- csQAQ API（G-1，采集必需）----
CSQAQ_API_TOKEN=

# ---- AUTH-1 登录门禁（2026-08-21 新增）----
# 单用户访问密码（必须配置；未配置时 /login 报错提示，登录不可用）
CS_MARKET_PASSWORD=
# 会话签名密钥（建议长随机串，如 python -c "import secrets;print(secrets.token_hex(32))"；
# 未配置时启动生成随机临时 key——重启后所有会话失效）
CS_MARKET_SESSION_SECRET=

# ---- 通知（可选）----
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
